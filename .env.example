# Database Connection URL (PostgreSQL)
# Local development default:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/resale_tickets?schema=public"

# Base URL for callbacks & links
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# PayOS Payment Gateway Sandbox Credentials
# Obtain these from https://payos.vn/ (Create a Sandbox App)
PAYOS_CLIENT_ID="your_payos_client_id"
PAYOS_API_KEY="your_payos_api_key"
PAYOS_CHECKSUM_KEY="your_payos_checksum_key"
